{
  "cSpell.words": [
    "biome",
    "biomejs",
    "commitlint",
    "dockerignore",
    "forgejs",
    "gitleaks",
    "hyperse",
    "lefthook",
    "npmrc",
    "osv",
    "publint",
    "releaserc",
    "snodeb",
    "tsdown",
    "typedoc",
    "vitest"
  ],
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": "explicit",
    "source.fixAll.biome": "explicit"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  }
}
