{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/read-counter.cjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-on-edit.cjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run type*)",
      "Bash(npm test*)",
      "Bash(npm run test*)"
    ],
    "deny": [
      "Read(./package-lock.json)",
      "Read(./docs/package-lock.json)",
      "Read(./coverage/**)",
      "Read(./dist/**)",
      "Read(./junit-report.xml)"
    ]
  }
}
